<Window x:Class="Rebar.RebarStair.View.RebarStairView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rebar.RebarStair.View"
        xmlns:viewModel="clr-namespace:RebarStair.RebarStair.ViewModel"
        xmlns:conv="clr-namespace:Rebar.RebarStair.View.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModel:RebarStairViewModel, IsDesignTimeCreatable=False}"
        Title="RebarStair"
        Width="1320" Height="780"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Window}">

    <Window.Resources>

        <!-- ============================================================
             DESIGN TOKENS  (một hệ thống duy nhất, đổi màu ở đây)
             Xanh dương = chọn / focus. Hổ phách = hành động chính.
             Đỏ = chỉ dành cho cốt thép.
             ============================================================ -->
        <SolidColorBrush x:Key="Brush.Window"      Color="#EDF0F5"/>
        <SolidColorBrush x:Key="Brush.Surface"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.SurfaceAlt"  Color="#F5F7FA"/>
        <SolidColorBrush x:Key="Brush.Viewport"    Color="#E8EDF5"/>
        <SolidColorBrush x:Key="Brush.Border"      Color="#D8DEE7"/>
        <SolidColorBrush x:Key="Brush.Text"        Color="#14233B"/>
        <SolidColorBrush x:Key="Brush.Muted"       Color="#5B6778"/>

        <SolidColorBrush x:Key="Brush.Navy"        Color="#0F2A52"/>
        <SolidColorBrush x:Key="Brush.NavyText"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.NavyMuted"   Color="#A9B8D2"/>
        <SolidColorBrush x:Key="Brush.NavyChip"    Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Brush.NavyChipBorder" Color="#24FFFFFF"/>

        <SolidColorBrush x:Key="Brush.Accent"      Color="#1D5FD1"/>
        <SolidColorBrush x:Key="Brush.AccentHover" Color="#174DAB"/>
        <SolidColorBrush x:Key="Brush.AccentSoft"  Color="#E5EEFC"/>

        <SolidColorBrush x:Key="Brush.Amber"       Color="#F2A33A"/>
        <SolidColorBrush x:Key="Brush.AmberHover"  Color="#E3922A"/>
        <SolidColorBrush x:Key="Brush.AmberInk"    Color="#2A1A00"/>

        <SolidColorBrush x:Key="Brush.Rebar"       Color="#D0342C"/>
        <SolidColorBrush x:Key="Brush.Concrete"    Color="#E3E6EA"/>
        <SolidColorBrush x:Key="Brush.Pill"        Color="#E6FFFFFF"/>

        <CornerRadius x:Key="Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Radius.Control">6</CornerRadius>

        <DropShadowEffect x:Key="Effect.Ring" ShadowDepth="0" BlurRadius="8" Color="#1D5FD1" Opacity="0.35"/>

        <!-- ============================================================
             ICONS  (nét đơn, 24x24)
             ============================================================ -->
        <Geometry x:Key="Icon.Cube">M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M12,12 L20,7.5 M12,12 L12,21 M12,12 L4,7.5</Geometry>
        <Geometry x:Key="Icon.Section">M3,18 L7,18 L7,14 L11,14 L11,10 L15,10 L15,6 L21,6 M3,21 L21,21</Geometry>
        <Geometry x:Key="Icon.Stair">M4,19 L8,19 L8,15 L12,15 L12,11 L16,11 L16,7 L20,7</Geometry>
        <Geometry x:Key="Icon.Bars">M4,7 L20,7 M4,12 L20,12 M4,17 L20,17</Geometry>
        <Geometry x:Key="Icon.Beam">M3,8 L21,8 L21,16 L3,16 Z M7,8 L7,11 M11,8 L11,10 M15,8 L15,11 M19,8 L19,10</Geometry>
        <Geometry x:Key="Icon.Plane">M3,15 L12,10 L21,15 L12,20 Z M12,4 L12,10</Geometry>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ============================================================
             TEXT
             ============================================================ -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <conv:SectionGeometryConverter x:Key="SectionGeometry"/>

        <!-- ============================================================
             CARD
             ============================================================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Padding" Value="16,14,16,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ============================================================
             TEXTBOX  (Tag = đơn vị hiển thị bên phải, ví dụ Tag="mm")
             ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Unit"
                                           Grid.Column="1"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Muted}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Unit" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Muted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             COMBOBOX  (cùng chiều cao, viền, mũi tên và danh sách thả với TextBox)
             ============================================================ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Margin="3,2"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,32,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Radius.Control}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Muted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <Path IsHitTestVisible="False"
                                  Data="M0,0 L4.5,4.5 L9,0"
                                  Width="9" Height="5"
                                  Margin="0,0,12,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.Muted}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Grid Margin="0,4,0,0"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource Brush.Surface}"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="0,3">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Toggle" Property="Effect" Value="{StaticResource Effect.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             BUTTONS
             ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Muted}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}"/>
            <Setter Property="Background" Value="{StaticResource Brush.Amber}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}"/>
            <Setter Property="Padding" Value="24,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AmberHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             RADIOBUTTON  (dạng segmented / chip)
             ============================================================ -->
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Padding="12,6"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Effect.Ring}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             TABCONTROL  (tab gạch chân, có đường kẻ dưới hàng tab)
             ============================================================ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,14,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Padding="2,8,2,9"
                                Margin="0,0,20,-1"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="392"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             HEADER
             ============================================================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Navy}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Logo: tiết diện bê tông với ba thanh thép -->
                    <Border Width="34" Height="34"
                            Background="{StaticResource Brush.Amber}"
                            CornerRadius="8">
                        <Border Width="18" Height="18"
                                BorderBrush="{StaticResource Brush.AmberInk}"
                                BorderThickness="1.8"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,2.5">
                                <Ellipse Width="3.4" Height="3.4" Margin="0.8,0" Fill="{StaticResource Brush.AmberInk}"/>
                                <Ellipse Width="3.4" Height="3.4" Margin="0.8,0" Fill="{StaticResource Brush.AmberInk}"/>
                                <Ellipse Width="3.4" Height="3.4" Margin="0.8,0" Fill="{StaticResource Brush.AmberInk}"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RebarStair"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.NavyText}"/>
                        <TextBlock Text="Bố trí thép cầu thang bê tông cốt thép"
                                   FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource Brush.NavyMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Loại cầu thang đang chọn -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,6"
                        Background="{StaticResource Brush.NavyChip}"
                        BorderBrush="{StaticResource Brush.NavyChipBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}">
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.NavyMuted}">
                        <Run Text="Loại cầu thang  "/>
                        <Run Text="{Binding SelectedType.Name, Mode=OneWay, FallbackValue='—'}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource Brush.NavyText}"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             TRÁI: 3D + MẶT CẮT 2D
             ============================================================ -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="16,16,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 3D native Revit PreviewControl -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,0" Height="46"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Cube}"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Mô hình 3D"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Background="{StaticResource Brush.Viewport}">
                        <!-- Hiện khi Revit PreviewControl chưa được tạo -->
                        <TextBlock Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   Text="Chưa có mô hình Revit để xem trước."/>

                        <!-- PreviewControl native của Revit -->
                        <ContentControl Content="{Binding PreviewContent}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Focusable="False"/>

                        <!-- Gợi ý thao tác -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="12" Padding="10,6"
                                Background="{StaticResource Brush.Pill}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Chọn số hiệu thép để tô đỏ thanh tương ứng · ViewCube và chuột để xoay, pan, zoom"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Margin="0,0,0,12"/>

            <!-- MẶT CẮT 2D -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,0" Height="46"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Section}"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Mặt cắt"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Right"
                                       Text="{Binding Section.ScaleText, FallbackValue=''}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{StaticResource Brush.Viewport}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="24"
                                   Text="{Binding SectionPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Viewbox Stretch="Uniform" Margin="20">
                            <Canvas Width="{Binding Section.Width, FallbackValue=600}"
                                    Height="{Binding Section.Height, FallbackValue=300}">

                                <!-- Tiết diện bê tông -->
                                <Path Data="{Binding Section, Converter={StaticResource SectionGeometry}, ConverterParameter=outline}"
                                      Fill="{StaticResource Brush.Concrete}"
                                      Stroke="{StaticResource Brush.Text}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"/>

                                <!-- Thép của số hiệu đang chọn -->
                                <Path Data="{Binding Section, Converter={StaticResource SectionGeometry}, ConverterParameter=rebar}"
                                      Stroke="{StaticResource Brush.Rebar}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- ============================================================
             PHẢI: THÔNG SỐ
             ============================================================ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      Margin="8,16,16,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- Cầu thang -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Stair}"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Cầu thang"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Bề rộng thang"/>
                                <TextBox Tag="mm" Text="{Binding R1}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Bề rộng chiếu nghỉ"/>
                                <TextBox Tag="mm" Text="{Binding D}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Loại cầu thang" Margin="0,12,0,4"/>
                        <ComboBox Name="StairType"
                                  ItemsSource="{Binding StairTypes}"
                                  SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>

                <!-- Bản thang -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bars}"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Bản thang"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Thép"/>
                        <ItemsControl ItemsSource="{Binding RebarOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="RebarOptionsGroup"
                                                 IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                 Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Chọn số hiệu để tô đỏ thanh thép đó trong mô hình 3D bên trái."/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Đường kính"/>
                                <ComboBox ItemsSource="{Binding RebarBarTypes}"
                                          SelectedItem="{Binding SelectedRebarOption.DuongKinh, Mode=TwoWay}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Khoảng cách"/>
                                <TextBox Tag="mm" Text="{Binding KhoangCach}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Lớp bảo vệ"/>
                                <TextBox Tag="mm" Text="{Binding Cover}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Neo -->
                <Border Style="{StaticResource Card}" Padding="16,4,16,16">
                    <TabControl>
                        <TabItem Header="Neo bản thang">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Vươn của thép (A)"/>
                                    <TextBox Tag="mm" Text="{Binding DoVuonCuaThep}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Độ dài neo (A1)"/>
                                    <TextBox Tag="mm" Text="{Binding DoDaiNeo}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="F1"/>
                                    <TextBox Tag="mm" Text="{Binding F1}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="F2"/>
                                    <TextBox Tag="mm" Text="{Binding F2}"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Neo chiếu nghỉ">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="L1"/>
                                    <TextBox Tag="mm" Text="{Binding L1CN}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="L2"/>
                                    <TextBox Tag="mm" Text="{Binding L2CN}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Đoạn kéo dài (A)"/>
                                    <TextBox Tag="mm" Text="{Binding F1}"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Dữ liệu khác -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Beam}"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Dữ liệu khác"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="B dầm"/>
                                <TextBox Tag="mm" Text="{Binding BDam}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="H dầm"/>
                                <TextBox Tag="mm" Text="{Binding HDam}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================
             FOOTER: HÀNH ĐỘNG
             ============================================================ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Command="{Binding PickWorkPlaneCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Icon.Plane}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Pick WorkPlane" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quit"
                            Margin="0,0,10,0"
                            Command="{Binding CloseCommand}"/>
                    <Button Content="Bố trí thép"
                            Margin="0,0,10,0"
                            Command="{Binding PreviewCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Xác nhận"
                            IsEnabled="{Binding HasPreview}"
                            Command="{Binding OkCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
