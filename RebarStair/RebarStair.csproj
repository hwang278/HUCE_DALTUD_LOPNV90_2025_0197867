<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType> 
		<TargetFramework>net10.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<NuGetAuditMode>all</NuGetAuditMode> 
		<!-- Revit 2026.5 host binaries reference facade versions different from the public net10 reference pack. -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Images\icon.png" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Rebar.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="RevitAPI" HintPath="$(RevitInstallDir)\RevitAPI.dll" Private="false" />
	  <Reference Include="RevitAPIUI" HintPath="$(RevitInstallDir)\RevitAPIUI.dll" Private="false" />
	</ItemGroup>
	<ItemGroup>
	  <Resource Include="Images\icon.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>
	<Target Name="DeployAddin" AfterTargets="AfterBuild">
		<Copy SourceFiles="$(ProjectDir)RebarStairAddin.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2026" SkipUnchangedFiles="true" />
	</Target>
	<Target Name="ExcludeRevitHostAssembliesFromOutput" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
				Condition="'%(Filename)' == 'RevitAPI' Or '%(Filename)' == 'RevitAPIUI' Or '%(Filename)' == 'UIFramework' Or '%(Filename)' == 'AdWindows'" />
		</ItemGroup>
	</Target>
</Project>
